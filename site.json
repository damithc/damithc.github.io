{
  "baseUrl": "",
  "titlePrefix": "",
  "titleSuffix": "",
  "timeZone": "Asia/Singapore",
  "style": {
    "codeTheme": "light",
    "codeLineNumbers": false
  },

  "ignore": [
    "_markbind/layouts/*",
    "_markbind/logs/*",
    "_site/*",
    "site.json",
    "*.md",
    "*.njk",
    ".git/*",
    ".gitignore",
    "node_modules/*"
  ],
  "pagesExclude": ["node_modules/*"],
  "pages": [
    {
      "src": "index.md"
    },
    {
      "glob": ["**/index.md", "**/*.md"]
    }
  ],
  "deploy": {
    "message": "Site Update.",
    "repo": "https://github.com/damithc/damithc.github.io.git",
    "branch": "gh-pages"
  }
}
